{
  "name": "codex-usage-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "26.5.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "build:e2e": "npm run build && cargo build --manifest-path ../Cargo.toml",
    "pretest:e2e": "npm run build:e2e",
    "test:e2e": "playwright test",
    "pretest:e2e:functional": "npm run build:e2e",
    "test:e2e:functional": "playwright test e2e/core.spec.ts",
    "pretest:e2e:performance": "npm run build:e2e",
    "test:e2e:performance": "playwright test e2e/performance.spec.ts --retries=0",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.2.7",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
